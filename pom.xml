<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.jenkins-ci.plugins</groupId>
        <artifactId>plugin</artifactId>
        <version>6.2221.va_045130417c9</version>
        <relativePath />
    </parent>
    <groupId>de.taimos</groupId>
    <artifactId>pipeline-aws</artifactId>
    <version>${changelist}</version>
    <packaging>hpi</packaging>
    <name>Pipeline: AWS Steps</name>
    <scm>
        <connection>scm:git:https://github.com/${gitHubRepo}.git</connection>
        <developerConnection>scm:git:git@github.com:${gitHubRepo}.git</developerConnection>
        <tag>${scmTag}</tag>
        <url>https://github.com/${gitHubRepo}</url>
    </scm>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.jenkins.tools.bom</groupId>
                <artifactId>bom-${jenkins.baseline}.x</artifactId>
                <version>6908.vb_4265a_9607c9</version>
                <scope>import</scope>
                <type>pom</type>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <licenses>
        <license>
            <name>The Apache Software License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution></license>
    </licenses>
    <url>https://github.com/jenkinsci/${project.artifactId}-plugin</url>
    <organization>
        <name>Taimos GmbH</name>
        <url>https://www.taimos.de</url>
    </organization>
    <developers>
        <developer>
            <id>hoegertn</id>
            <name>Thorsten Hoeger</name>
            <email>thorsten.hoeger@taimos.de</email>
            <organization>Taimos GmbH</organization>
            <organizationUrl>https://www.taimos.de</organizationUrl>
        </developer>
    </developers>
    <contributors>
        <contributor>
            <name>Matthew Douglass</name>
        </contributor>
        <contributor>
            <name>Giovanni Gargiulo</name>
        </contributor>
        <contributor>
            <name>Tyler Southwick</name>
        </contributor>
        <contributor>
            <name>Ryan Davis</name>
        </contributor>
    </contributors>
    <repositories>
        <repository>
            <id>repo.jenkins-ci.org</id>
            <url>https://repo.jenkins-ci.org/public/</url>
        </repository>
    </repositories>
    <pluginRepositories>
        <pluginRepository>
            <id>repo.jenkins-ci.org</id>
            <url>https://repo.jenkins-ci.org/public/</url>
        </pluginRepository>
    </pluginRepositories>
    <properties>
        <changelist>999999-SNAPSHOT</changelist>
        <!-- https://www.jenkins.io/doc/developer/plugin-development/choosing-jenkins-baseline/ -->
        <jenkins.baseline>2.541</jenkins.baseline>
        <jenkins.version>${jenkins.baseline}.1</jenkins.version>
        <gitHubRepo>jenkinsci/${project.artifactId}-plugin</gitHubRepo>
        <ban-commons-lang-2.skip>false</ban-commons-lang-2.skip>
    </properties>
    <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>3.0.0</version>
        <executions>
          <execution>
            <id>validate</id>
            <phase>validate</phase>
            <configuration>
              <configLocation>checkstyle.xml</configLocation>
              <encoding>UTF-8</encoding>
              <consoleOutput>true</consoleOutput>
              <failsOnError>true</failsOnError>
            </configuration>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.32</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jenkins-ci.plugins.workflow</groupId>
            <artifactId>workflow-step-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jenkins-ci.plugins</groupId>
            <artifactId>script-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jenkins-ci.plugins</groupId>
            <artifactId>structs</artifactId>
        </dependency>

        <!--
            AWS SDK for Java 2.x, one module per service the steps talk to. aws-java-sdk2-core
            bundles auth, regions, retries, profiles, sts and the Apache sync HTTP client, so the
            client plumbing in AWSClientFactory needs nothing beyond it.
        -->
        <dependency>
            <groupId>io.jenkins.plugins.aws-java-sdk2</groupId>
            <artifactId>aws-java-sdk2-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jenkins.plugins.aws-java-sdk2</groupId>
            <artifactId>aws-java-sdk2-sns</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jenkins.plugins.aws-java-sdk2</groupId>
            <artifactId>aws-java-sdk2-ec2</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jenkins.plugins.aws-java-sdk2</groupId>
            <artifactId>aws-java-sdk2-iam</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jenkins.plugins.aws-java-sdk2</groupId>
            <artifactId>aws-java-sdk2-organizations</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jenkins.plugins.aws-java-sdk2</groupId>
            <artifactId>aws-java-sdk2-elasticloadbalancingv2</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jenkins.plugins.aws-java-sdk2</groupId>
            <artifactId>aws-java-sdk2-codedeploy</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jenkins.plugins.aws-java-sdk2</groupId>
            <artifactId>aws-java-sdk2-apigateway</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jenkins.plugins.aws-java-sdk2</groupId>
            <artifactId>aws-java-sdk2-elasticbeanstalk</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jenkins.plugins.aws-java-sdk2</groupId>
            <artifactId>aws-java-sdk2-lambda</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jenkins.plugins.aws-java-sdk2</groupId>
            <artifactId>aws-java-sdk2-cloudfront</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jenkins.plugins.aws-java-sdk2</groupId>
            <artifactId>aws-java-sdk2-ecr</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jenkins.plugins.aws-java-sdk2</groupId>
            <artifactId>aws-java-sdk2-cloudformation</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jenkins.plugins.aws-java-sdk2</groupId>
            <artifactId>aws-java-sdk2-s3</artifactId>
        </dependency>
        <!--
            S3TransferManager needs an S3AsyncClient, which needs an asynchronous HTTP client, and
            neither aws-java-sdk2-core nor aws-java-sdk2-s3 brings one - only the Apache sync client.
            The CRT-based client is not published as an API plugin at all, so netty is the option that
            exists. It arrives as a plugin dependency (io.jenkins.plugins:netty-api) rather than a
            bundled jar, and it is the one SDK module that has to reach agents, because s3Upload and
            s3Download build their own clients there.
        -->
        <dependency>
            <groupId>io.jenkins.plugins.aws-java-sdk2</groupId>
            <artifactId>aws-java-sdk2-netty-nio-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jenkins-ci.plugins</groupId>
            <artifactId>credentials</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jenkins-ci.plugins</groupId>
            <artifactId>plain-credentials</artifactId>
        </dependency>
        <!--
            aws-credentials depends on the AWS SDK v1 plugins as well as the v2 ones, because its
            AmazonWebServicesCredentials implements both SDKs' provider interfaces. That is now the
            only thing putting SDK v1 on this plugin's classpath: nothing in src/main references
            com.amazonaws any more, and the one place src/test does is a stub implementing that
            interface, which cannot compile without the v1 method it declares. It also brings two
            versions of com.sun.xml.bind:jaxb-impl into range of RequireUpperBoundDeps: 2.3.9
            through io.jenkins.plugins:jaxb, and 4.0.9 through io.jenkins.plugins:jakarta-xml-bind-api.

            Only the library is excluded; the jaxb plugin itself has to stay, because jackson2-api
            needs it at runtime. Excluding the plugin instead compiles and passes the functional
            tests while leaving the plugin unloadable, which InjectedTest catches.

            This exclusion goes when aws-credentials drops SDK v1 (jenkinsci/aws-credentials-plugin#284,
            open since 2025 and deliberately held back for plugins that have not migrated). This
            plugin migrating is one fewer reason to hold it back.
        -->
        <dependency>
            <groupId>org.jenkins-ci.plugins</groupId>
            <artifactId>aws-credentials</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>com.sun.xml.bind</groupId>
                    <artifactId>jaxb-impl</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.jenkins.plugins</groupId>
            <artifactId>snakeyaml-api</artifactId>
        </dependency>
        <dependency>
            <groupId>xerces</groupId>
            <artifactId>xercesImpl</artifactId>
            <version>2.12.0</version>
        </dependency>

        <dependency>
            <groupId>org.jenkins-ci.plugins.workflow</groupId>
            <artifactId>workflow-job</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jenkins-ci.plugins.workflow</groupId>
            <artifactId>workflow-cps</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jenkins-ci.plugins.workflow</groupId>
            <artifactId>workflow-basic-steps</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jenkins-ci.plugins.workflow</groupId>
            <artifactId>workflow-durable-task-step</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jenkins-ci.plugins.workflow</groupId>
            <artifactId>workflow-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jenkins-ci.plugins.workflow</groupId>
            <artifactId>workflow-support</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jenkins-ci.plugins</groupId>
            <artifactId>cloudbees-folder</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.25.3</version>
            <scope>test</scope>
        </dependency>
        <!-- https://mvnrepository.com/artifact/net.bytebuddy/byte-buddy -->
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy</artifactId>
            <version>1.14.12</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>
